VITE_API_URL=http://localhost:8000
VITE_REALTIME_FALLBACK_POLL_SECONDS=5

# Toggle frontend browser-push enrollment UI.
VITE_FIREBASE_PUSH_ENABLED=false

# Firebase web app configuration (from Firebase project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging Web Push certificate key pair.
VITE_FIREBASE_VAPID_KEY=

# Optional Firebase SDK version override used by browserPushService.
VITE_FIREBASE_SDK_VERSION=10.13.2
